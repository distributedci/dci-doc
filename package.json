{
  "name": "dci-doc",
  "version": "1.0.0",
  "description": "Documentation for DCI",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-cip/dci-doc"
  },
  "scripts": {
    "start": "honkit serve",
    "clean": "rm -rf ./docs && mkdir ./docs",
    "pdf": "honkit pdf ./ ./dci-doc-\"`echo $npm_package_version`\".pdf",
    "static": "honkit build",
    "build": "npm-run-all clean static copy",
    "copy": "cp -r ./_book/* ./docs/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gitbook-plugin-advanced-emoji": "^0.2.2",
    "gitbook-plugin-anchors": "^0.7.1",
    "graceful-fs": "^4.2.9",
    "honkit": "^3.7.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
